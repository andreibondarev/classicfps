; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Classic FPS"
config/description="A precision tactical FPS built from the CS 1.6 replay fidelity project."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.07058824, 0.06666667, 0.0627451, 1)
boot_splash/image="res://assets/branding/splash.png"
config/icon="res://assets/branding/icon.png"

[autoload]

GameSettings="*res://scripts/settings.gd"
NetworkSession="*res://scripts/network_session.gd"
WebPerfLog="*res://scripts/web_perf_log.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[navigation]

3d/default_cell_size=0.04
3d/default_cell_height=0.02

[physics]

common/physics_ticks_per_second=100
common/max_physics_steps_per_frame=16
3d/physics_engine="Jolt Physics"
jolt_physics_3d/queries/enable_ray_cast_face_index=true
jolt_physics_3d/collisions/collision_margin_fraction=0.0
3d/default_gravity=8.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=16
anti_aliasing/quality/msaa_3d=2
textures/default_filters/texture_mipmap_bias=-0.3
environment/defaults/default_clear_color=Color(0.018, 0.027, 0.043, 1)
