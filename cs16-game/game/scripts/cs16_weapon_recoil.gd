static func parameters(weapon: String, grounded: bool, moving: bool, crouched: bool) -> Array:
	if not TABLE.has(weapon): return []
	var move_first := weapon in ["ak47", "m4a1", "aug", "sg552", "famas", "galil"]
	var index: int
	if move_first:
		index = 0 if moving else (1 if not grounded else (2 if crouched else 3))
	else:
		index = 0 if not grounded else (1 if moving else (2 if crouched else 3))
	return TABLE[weapon][index]
