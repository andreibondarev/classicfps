# Serves the browser build and forwards browser players' WebSocket to the
# dedicated server. Caddy obtains and renews the TLS certificate itself; the
# page is https, so the game must be reached as wss:// on the same host.
#
# Set the domains in a systemd drop-in (deploy/caddy-protocol47.conf):
#   Environment=PROTOCOL47_DOMAIN=play.example.com
#   Environment="PROTOCOL47_REDIRECT_DOMAINS=www.play.example.com old.example"
# Every redirect domain needs its own DNS record so Caddy can certify it.
{$PROTOCOL47_REDIRECT_DOMAINS} {
	redir https://{$PROTOCOL47_DOMAIN}{uri} permanent
}

{$PROTOCOL47_DOMAIN} {
	# JSON access log to the journal: the admin service reads /ws entries to
	# recover browser players' IPs (the game only sees this proxy).
	log {
		output stderr
		format json
	}

	# Admin dashboard (deploy/admin), password-protected. The bcrypt hash is
	# set in the systemd drop-in as PROTOCOL47_ADMIN_HASH.
	redir /admin /admin/
	handle_path /admin/* {
		basicauth {
			admin {$PROTOCOL47_ADMIN_HASH}
		}
		reverse_proxy 127.0.0.1:8090
	}

	# The game joins wss://<this host>/ws by default.
	handle /ws {
		reverse_proxy 127.0.0.1:27448
	}

	handle {
		root * /var/www/protocol47
		# game:build:web writes .br/.gz copies of the large files, so they are
		# never compressed on the fly.
		file_server {
			precompressed br gzip
		}
		@engine path /index.pck /index.wasm /index.js
		header @engine Cache-Control "no-cache"
	}
}
